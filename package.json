{
  "name": "erledo-rework",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "progress:update": "node scripts/update-progress.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs && node scripts/prepare-inline-assets.mjs && node scripts/prepare-bento-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "lenis": "^1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
